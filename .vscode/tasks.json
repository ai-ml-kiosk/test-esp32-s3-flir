{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "PlatformIO: Build",
      "type": "shell",
      "command": "pio",
      "args": ["run"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "PlatformIO: Upload",
      "type": "shell",
      "command": "pio",
      "args": ["run", "--target", "upload"],
      "problemMatcher": []
    },
    {
      "label": "PlatformIO: Monitor",
      "type": "shell",
      "command": "pio",
      "args": ["device", "monitor", "--port", "/dev/cu.usbmodem5C4C2151231", "--baud", "115200"],
      "problemMatcher": []
    }
  ]
}
